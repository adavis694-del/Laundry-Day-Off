# REQUIRED at launch: your real domain, so social-share images/links resolve correctly.
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com

# REQUIRED for accounts/orders: Supabase Dashboard -> Project Settings -> API.
# Use the anon / publishable key only. NEVER put the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Not used yet. Needed when you wire up the real integrations (see README).
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# SENDGRID_API_KEY=
